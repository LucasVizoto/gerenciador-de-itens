# Copie para .env para personalizar o docker compose (todos os valores têm padrão).
POSTGRES_USER=edital
POSTGRES_PASSWORD=edital
POSTGRES_DB=edital

# Portas publicadas no host
DB_PORT=5432
API_PORT=3333
WEB_PORT=8080

LOG_LEVEL=info
# true = cria o sistema de demonstração "Gestão de Frotas" se o banco estiver vazio
SEED_DEMO=true
