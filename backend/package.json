{
  "name": "gerenciador-itens-edital-api",
  "version": "0.1.0",
  "private": true,
  "description": "API Fastify para controle de conformidade de itens de editais de licitação",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/multipart": "10.1.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "csv-parse": "7.0.3",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
